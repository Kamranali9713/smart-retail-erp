// ================================================================
// Smart Retail ERP & POS System - Prisma Schema
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------
// USERS / ROLES / PERMISSIONS
// ----------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  MANAGER
  CASHIER
  ACCOUNTANT
  INVENTORY_STAFF
}

model Role {
  id          String       @id @default(cuid())
  name        RoleName     @unique
  label       String
  description String?
  permissions Permission[] @relation("RolePermissions")
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id     String @id @default(cuid())
  module String // e.g. "pos", "inventory", "accounting"
  action String // e.g. "view", "create", "edit", "delete"
  roles  Role[] @relation("RolePermissions")

  @@unique([module, action])
}

model User {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  password    String
  roleId      String
  role        Role       @relation(fields: [roleId], references: [id])
  isActive    Boolean    @default(true)
  lastLoginAt DateTime?
  loginLogs   LoginLog[]
  auditLogs   AuditLog[]
  sales       Sale[]
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ip        String?
  userAgent String?
  status    String // SUCCESS | FAILED
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | SALE | PURCHASE | STOCK_CHANGE
  module    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------
// PRODUCTS / INVENTORY
// ----------------------------------------------------------------

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Unit {
  id       String    @id @default(cuid())
  name     String    @unique // pcs, kg, box, litre
  products Product[]
}

model Product {
  id            String           @id @default(cuid())
  name          String
  sku           String           @unique
  barcode       String?          @unique
  description   String?
  images        String[]         @default([])
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?           @relation(fields: [brandId], references: [id])
  unitId        String?
  unit          Unit?            @relation(fields: [unitId], references: [id])
  costPrice     Decimal          @default(0) @db.Decimal(12, 2)
  sellingPrice  Decimal          @default(0) @db.Decimal(12, 2)
  taxRate       Decimal          @default(0) @db.Decimal(5, 2)
  lowStockAlert Int              @default(10)
  expiryDate    DateTime?
  isActive      Boolean          @default(true)
  variants      ProductVariant[]
  stock         Stock?
  inventoryLogs InventoryLog[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String // e.g. "Size: L", "Color: Red"
  skuSuffix String?
  priceDiff Decimal @default(0) @db.Decimal(12, 2)
}

model Stock {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int      @default(0)
  reservedQty Int      @default(0)
  updatedAt   DateTime @updatedAt
}

enum InventoryAction {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  SALE
  RETURN
  PURCHASE
}

model InventoryLog {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  action    InventoryAction
  quantity  Int
  reason    String?
  refId     String? // linked sale/purchase id
  createdAt DateTime        @default(now())
}

// ----------------------------------------------------------------
// VENDORS / PURCHASES
// ----------------------------------------------------------------

model Vendor {
  id        String          @id @default(cuid())
  name      String
  contact   String?
  email     String?
  address   String?
  status    String          @default("ACTIVE") // ACTIVE | INACTIVE
  purchases Purchase[]
  payments  VendorPayment[]
  createdAt DateTime        @default(now())
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  RETURNED
  CANCELLED
}

model Purchase {
  id          String         @id @default(cuid())
  invoiceNo   String         @unique
  vendorId    String
  vendor      Vendor         @relation(fields: [vendorId], references: [id])
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  status      PurchaseStatus @default(PENDING)
  items       PurchaseItem[]
  totalAmount Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount  Decimal        @default(0) @db.Decimal(12, 2)
  createdAt   DateTime       @default(now())
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
}

model VendorPayment {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  method    String
  note      String?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------
// CUSTOMERS / SALES / POS
// ----------------------------------------------------------------

model Customer {
  id        String            @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  sales     Sale[]
  payments  CustomerPayment[]
  createdAt DateTime          @default(now())
}

model CustomerPayment {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  note       String?
  createdAt  DateTime      @default(now())
}

enum SaleStatus {
  COMPLETED
  HELD
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CREDIT
}

model Sale {
  id             String        @id @default(cuid())
  invoiceNo      String        @unique
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  items          SaleItem[]
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  discountPct    Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @default(CASH)
  status         SaleStatus    @default(COMPLETED)
  returns        Return[]
  createdAt      DateTime      @default(now())
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)
}

model Return {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  reason    String?
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------
// ACCOUNTING
// ----------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id           String        @id @default(cuid())
  name         String        @unique
  type         AccountType
  balance      Decimal       @default(0) @db.Decimal(14, 2)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

model JournalEntry {
  id           String        @id @default(cuid())
  entryNo      String        @unique
  description  String?
  refType      String?
  refId        String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@index([createdAt])
  @@index([refType, refId])
}

model Transaction {
  id             String        @id @default(cuid())
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id])
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  type           String // DEBIT | CREDIT
  amount         Decimal       @db.Decimal(14, 2)
  description    String?
  refType        String? // SALE | PURCHASE | MANUAL | EXPENSE | INCOME
  refId          String?
  createdAt      DateTime      @default(now())

  @@index([accountId, createdAt])
  @@index([refType, refId])
  @@index([journalEntryId])
}

model Income {
  id        String   @id @default(cuid())
  source    String
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())
}

model Expense {
  id        String   @id @default(cuid())
  category  String
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------
// SETTINGS / BACKUPS
// ----------------------------------------------------------------

model Settings {
  id                String   @id @default("singleton")
  storeName         String   @default("My Store")
  logoUrl           String?
  address           String?
  phone             String?
  email             String?
  defaultTaxRate    Decimal  @default(0) @db.Decimal(5, 2)
  receiptWidth      String   @default("80mm") // 58mm | 80mm
  lowStockThreshold Int      @default(10)
  autoBarcode       Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model Backup {
  id        String   @id @default(cuid())
  fileName  String
  sizeBytes Int
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())
}
